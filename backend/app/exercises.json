{
  "split-chunks": {
    "function": "split_chunks",
    "solution": "def split_chunks(text, size):\n    chunks = []\n    for i in range(0, len(text), size):\n        chunks.append(text[i:i + size])\n    return chunks",
    "cases": [
      {
        "args": [
          "hello world",
          4
        ],
        "expect": {
          "return": [
            "hell",
            "o wo",
            "rld"
          ]
        }
      },
      {
        "args": [
          "",
          3
        ],
        "expect": {
          "return": []
        }
      },
      {
        "args": [
          "abc",
          5
        ],
        "expect": {
          "return": [
            "abc"
          ]
        }
      },
      {
        "args": [
          "abcdef",
          3
        ],
        "expect": {
          "return": [
            "abc",
            "def"
          ]
        }
      },
      {
        "args": [
          "abcdefg",
          1
        ],
        "expect": {
          "return": [
            "a",
            "b",
            "c",
            "d",
            "e",
            "f",
            "g"
          ]
        }
      },
      {
        "args": [
          "Nhân viên được nghỉ phép 12 ngày/năm. Phép chưa dùng hết được cộng dồn sang quý 1 năm sau.",
          30
        ],
        "expect": {
          "return": [
            "Nhân viên được nghỉ phép 12 ng",
            "ày/năm. Phép chưa dùng hết đượ",
            "c cộng dồn sang quý 1 năm sau."
          ]
        }
      }
    ]
  },
  "overlap-chunks": {
    "function": "overlap_chunks",
    "solution": "def overlap_chunks(text, size, overlap):\n    chunks = []\n    for i in range(0, len(text), size - overlap):\n        chunks.append(text[i:i + size])\n    return chunks",
