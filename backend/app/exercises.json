          "abcdef",
          3,
          0
        ],
        "expect": {
          "return": [
            "abc",
            "def"
          ]
        }
      },
      {
        "args": [
          "Nhân viên được nghỉ phép 12 ngày/năm. Phép chưa dùng hết được cộng dồn sang quý 1 năm sau.",
          30,
          5
