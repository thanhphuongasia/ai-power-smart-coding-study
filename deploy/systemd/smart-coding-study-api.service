[Unit]
Description=Smart Coding Study API (FastAPI: /content, /run)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=smartcs
Group=smartcs
WorkingDirectory=/opt/smart-coding-study/backend
# DATABASE_URL (có mật khẩu), CODE_RUNNER, JUDGE0_URL — chỉ nằm trên server, quyền 640.
EnvironmentFile=/etc/smart-coding-study.env
ExecStart=/opt/smart-coding-study/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/smart-coding-study

[Install]
WantedBy=multi-user.target
